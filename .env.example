# Copia este archivo a .env y rellena los valores. .env está en .gitignore
# — nunca lo subas a un repo, ni lo compartas.

# Token long-lived o de system user, con permisos:
# instagram_basic, instagram_manage_comments, instagram_manage_insights,
# pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=

# ID numérico de tu cuenta de Instagram Business/Creator
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Opcional: palabras-CTA propias además de las por defecto (info, precio,
# quiero, guía, curso...), separadas por coma
IG_TRIGGERS=
